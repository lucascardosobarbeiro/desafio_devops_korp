# Imagem construída pelo playbook e consumida pelo Compose sem acesso a registry externo.
APP_IMAGE_TAG={{ app_image_tag }}

# Portas parametrizadas para manter o compose.yaml reutilizável.
NGINX_PORT={{ nginx_port }}
PROMETHEUS_PORT={{ prometheus_port }}
GRAFANA_PORT={{ grafana_port }}

# Credenciais recebidas de group_vars; use Ansible Vault fora do ambiente de demonstração.
GRAFANA_ADMIN_USER={{ grafana_admin_user }}
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password }}
