# Tag da imagem local construída para o serviço Go.
APP_IMAGE_TAG=1.0.0

# Portas publicadas pelo NGINX, Prometheus local e Grafana.
NGINX_PORT=80
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Exemplo sem segredo real: copie para .env e substitua o marcador antes de iniciar o Compose.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
